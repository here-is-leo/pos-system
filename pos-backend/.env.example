# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# Security
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100