// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// 📌 مدل کاربران
// ============================================
model User {
  id           Int    @id @default(autoincrement())
  fullName     String @map("full_name")
  phone        String @unique
  passwordHash String @map("password_hash")
  role         String @default("sales")
  isActive     Boolean @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customers   Customer[]  @relation("salesUser")
  inventories Inventory[] @relation("updatedBy")
  invoices    Invoice[]   @relation("salesUser")
  logs        InventoryLog[] @relation("createdBy")
  notifications Notification[]
  payments    PaymentTransaction[]

  @@map("users")
}

// ============================================
// 📌 مدل انبار
// ============================================
model Warehouse {
  id        Int    @id @default(autoincrement())
  name      String
  address   String?
  managerId Int?  @map("manager_id")
  createdAt DateTime @default(now()) @map("created_at")

  products  Product[]
  inventory Inventory[]
  logs      InventoryLog[]

  @@map("warehouses")
}

// ============================================
// 📌 مدل محصولات
// ============================================
model Product {
  id             Int      @id @default(autoincrement())
  name           String
  productCode    String?  @unique @map("product_code") // 🔥 کد کالا (اختیاری و یکتا)
  barcode        String?  @unique
  unitType       String   @default("single") @map("unit_type")
  cartonSize     Int?     @map("carton_size")
  pricePerCarton Float?   @map("price_per_carton")
  unitPrice      Float    @map("unit_price")
  costPrice      Float    @map("cost_price")
  warehouseId    Int      @map("warehouse_id")
  minStock       Int      @default(0) @map("min_stock")
  createdAt      DateTime @default(now()) @map("created_at")

  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  inventory   Inventory?
  items       InvoiceItem[]
  logs        InventoryLog[]

  @@map("products")
}
// ============================================
// 📌 مدل موجودی انبار
// ============================================
model Inventory {
  id          Int    @id @default(autoincrement())
  productId   Int    @unique @map("product_id")
  warehouseId Int    @map("warehouse_id")
  quantity    Float  @default(0)
  lastUpdated DateTime @default(now()) @map("last_updated")
  updatedBy   Int?   @map("updated_by")

  product    Product   @relation(fields: [productId], references: [id])
  warehouse  Warehouse @relation(fields: [warehouseId], references: [id])
  updatedByUser User?  @relation("updatedBy", fields: [updatedBy], references: [id])

  @@map("inventory")
}

// ============================================
// 📌 مدل مشتریان
// ============================================
model Customer {
  id               Int    @id @default(autoincrement())
  name             String
  address          String?
  phone            String?
  nationalId       String? @map("national_id")
  totalPurchases   Float  @default(0) @map("total_purchases")
  lastPurchaseDate DateTime? @map("last_purchase_date")
  createdAt        DateTime @default(now()) @map("created_at")

  salesUserId Int? @map("sales_user_id")
  salesUser   User? @relation("salesUser", fields: [salesUserId], references: [id])
  invoices    Invoice[]
  payments    PaymentTransaction[]

  @@map("customers")
}

// ============================================
// 📌 مدل فاکتورها (با فیلدهای جدید تسویه)
// ============================================
model Invoice {
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique @map("invoice_number")
  customerId    Int    @map("customer_id")
  salesUserId   Int    @map("sales_user_id")
  totalAmount   Float  @default(0) @map("total_amount")
  totalDiscount Float  @default(0) @map("total_discount")
  finalAmount   Float  @default(0) @map("final_amount")
  
  // 🔥 فیلدهای جدید تسویه
  totalPaid     Float  @default(0) @map("total_paid")
  remainingDebt Float  @default(0) @map("remaining_debt")
  isSettled     Boolean @default(false) @map("is_settled")
  previousDebt  Float  @default(0) @map("previous_debt")
  
  status        String @default("draft") // draft, final, paid, settled
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])
  salesUser User    @relation("salesUser", fields: [salesUserId], references: [id])
  items     InvoiceItem[]
  payments  PaymentTransaction[]

  @@map("invoices")
}

// ============================================
// 📌 مدل آیتم‌های فاکتور
// ============================================
model InvoiceItem {
  id                 Int    @id @default(autoincrement())
  invoiceId          Int    @map("invoice_id")
  productId          Int    @map("product_id")
  quantity           Float
  unitPrice          Float  @map("unit_price")
  discountType       String @default("fixed") @map("discount_type")
  discountValue      Float  @default(0) @map("discount_value")
  discountPercentage Float  @default(0) @map("discount_percentage")
  finalPrice         Float  @map("final_price")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

// ============================================
// 📌 مدل لاگ‌های موجودی
// ============================================
model InventoryLog {
  id                 Int    @id @default(autoincrement())
  productId          Int    @map("product_id")
  warehouseId        Int    @map("warehouse_id")
  changeType         String @map("change_type")
  quantity           Float
  reason             String
  referenceInvoiceId Int?   @map("reference_invoice_id")
  createdAt          DateTime @default(now()) @map("created_at")
  createdBy          Int?   @map("created_by")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdByUser User? @relation("createdBy", fields: [createdBy], references: [id])

  @@map("inventory_logs")
}

// ============================================
// 📌 مدل نوتیفیکیشن‌ها
// ============================================
model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String
  title       String
  description String
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ============================================
// 📌 مدل تراکنش‌های پرداخت (جدید)
// ============================================
model PaymentTransaction {
  id           Int      @id @default(autoincrement())
  invoiceId    Int      @map("invoice_id")
  customerId   Int      @map("customer_id")
  amount       Float
  paymentDate  DateTime @default(now()) @map("payment_date")
  paymentType  String   @default("cash") @map("payment_type")
  description  String?
  createdBy    Int      @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  
  invoice  Invoice  @relation(fields: [invoiceId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [createdBy], references: [id])
  
  @@map("payment_transactions")
}